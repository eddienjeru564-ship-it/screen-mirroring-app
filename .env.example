# ScreenView configuration — copy to `.env` and adjust, or set these in your shell.
# Every value has a sensible default; the app runs with zero config on a LAN.

# HTTP port (local server only; Vercel picks its own)
PORT=3000

# Admin dashboard password (CHANGE THIS before exposing /admin).
# If unset, /admin is disabled and returns 503.
ADMIN_PASSWORD=change-me

# --- Session behaviour ---
# How long an unused join code stays valid, in milliseconds (default 10 min).
# Lower this in tests, e.g. CODE_EXPIRY_MS=2000.
CODE_EXPIRY_MS=600000

# Grace period (ms) a session survives after the host disconnects before teardown.
GRACE_MS=60000

# How long (ms) a viewer may go without contacting the server before it is
# counted as gone. It is re-admitted automatically (no code) when it comes back.
VIEWER_STALE_MS=12000

# Max simultaneous viewers per session (default 1; up to 3 supported).
MAX_VIEWERS=1

# --- Rate limiting (brute-force protection on join codes) ---
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# --- NAT traversal ---
# Google public STUN is always used. TURN is optional and only needed when
# host and viewer cannot reach each other directly (e.g. symmetric NAT).
# Leave blank to run STUN-only (works on the same LAN).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Session storage ---
# Locally, sessions are kept in memory (nothing to set up). On Vercel, where
# every request can run on a different server, a shared store is REQUIRED:
#
# Option A, Supabase: run supabase/migrations/0001_screenview_store.sql in the
# project, insert a random secret into screenview_config (k='secret'), and set:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SCREENVIEW_STORE_SECRET=
#
# Option B, Upstash Redis: adding Upstash to the Vercel project (Storage ->
# Upstash for Redis) sets these automatically:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too.)

# --- Logging ---
# Where the append-only session log is written (default logs/sessions.jsonl).
# On Vercel the log is kept in the store instead (newest 5000 events).
# LOG_FILE=logs/sessions.jsonl
