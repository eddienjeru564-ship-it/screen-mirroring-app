# ScreenView configuration — copy to `.env` and adjust, or set these in your shell.
# Every value has a sensible default; the app runs with zero config on a LAN.

# HTTP / signaling port
PORT=3000

# Admin dashboard password (CHANGE THIS before exposing /admin).
# If unset, /admin is disabled and returns 503.
ADMIN_PASSWORD=change-me

# --- Session behaviour ---
# How long an unused join code stays valid, in milliseconds (default 10 min).
# Lower this in tests, e.g. CODE_EXPIRY_MS=2000.
CODE_EXPIRY_MS=600000

# Grace period (ms) a session survives after the host disconnects before teardown.
GRACE_MS=60000

# Max simultaneous viewers per session (1–3 supported).
MAX_VIEWERS=3

# --- Rate limiting (brute-force protection on join codes) ---
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# --- NAT traversal ---
# Google public STUN is always used. TURN is optional and only needed when
# host and viewer cannot reach each other directly (e.g. symmetric NAT).
# Leave blank to run STUN-only (works on the same LAN).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
