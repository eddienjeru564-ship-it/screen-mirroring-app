{
  "name": "screenview",
  "version": "1.0.0",
  "description": "View-only live screen sharing over WebRTC, connected by a short join code.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:soak": "SOAK=1 playwright test tests/e2e/soak.spec.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "socket.io-client": "^4.8.1"
  }
}
